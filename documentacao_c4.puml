@startuml Distribuidora Ferreira - C4 Model
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Sistema de Gestão - Distribuidora Ferreira (Modelo C4 - Nível de Componentes)

Person(usuario, "Usuário", "Funcionário da distribuidora")

System_Boundary(distribuidora, "Sistema Distribuidora Ferreira") {
    
    Container(frontend, "Frontend Angular", "Angular 17, TypeScript", "Interface web responsiva para gestão do negócio")
    
    Container_Boundary(backend, "Backend Spring Boot") {
        
        Component(produtoController, "Produto Controller", "REST Controller", "Gerencia produtos, categorias e estoque")
        Component(vendaController, "Venda Controller", "REST Controller", "Processa vendas e controle de caixa")
        Component(compraController, "Compra Controller", "REST Controller", "Registra compras de fornecedores")
        Component(comandaController, "Comanda Controller", "REST Controller", "Gerencia comandas abertas")
        Component(clienteController, "Cliente Controller", "REST Controller", "Gerencia contas de clientes")
        Component(caixaController, "Caixa Controller", "REST Controller", "Controla abertura/fechamento de caixa")
        
        Component(produtoService, "Produto Service", "Service Layer", "Lógica de negócio de produtos")
        Component(vendaService, "Venda Service", "Service Layer", "Lógica de negócio de vendas")
        Component(compraService, "Compra Service", "Service Layer", "Lógica de negócio de compras")
        Component(comandaService, "Comanda Service", "Service Layer", "Lógica de negócio de comandas")
        Component(clienteService, "Cliente Service", "Service Layer", "Lógica de negócio de clientes")
        Component(caixaService, "Caixa Service", "Service Layer", "Lógica de negócio de caixa")
        Component(movimentacaoService, "Movimentação Service", "Service Layer", "Controla entradas/saídas de estoque")
        
        ComponentDb(produtoRepo, "Produto Repository", "JPA Repository", "Acesso a dados de produtos")
        ComponentDb(vendaRepo, "Venda Repository", "JPA Repository", "Acesso a dados de vendas")
        ComponentDb(compraRepo, "Compra Repository", "JPA Repository", "Acesso a dados de compras")
        ComponentDb(comandaRepo, "Comanda Repository", "JPA Repository", "Acesso a dados de comandas")
        ComponentDb(clienteRepo, "Cliente Repository", "JPA Repository", "Acesso a dados de clientes")
        ComponentDb(caixaRepo, "Caixa Repository", "JPA Repository", "Acesso a dados de caixa")
        ComponentDb(movimentacaoRepo, "Movimentação Repository", "JPA Repository", "Acesso a dados de movimentações")
        ComponentDb(categoriaRepo, "Categoria Repository", "JPA Repository", "Acesso a dados de categorias")
    }
    
    ContainerDb(database, "PostgreSQL Database", "PostgreSQL 14+", "Armazena todos os dados do sistema")
}

System_Ext(heroku, "Heroku Platform", "Hospedagem cloud do backend")
System_Ext(uploadcare, "Uploadcare", "Armazenamento de imagens de produtos")

' Relações usuário -> frontend
Rel(usuario, frontend, "Utiliza", "HTTPS")

' Relações frontend -> backend
Rel(frontend, produtoController, "Gerencia produtos", "REST/JSON")
Rel(frontend, vendaController, "Registra vendas", "REST/JSON")
Rel(frontend, compraController, "Registra compras", "REST/JSON")
Rel(frontend, comandaController, "Gerencia comandas", "REST/JSON")
Rel(frontend, clienteController, "Gerencia clientes", "REST/JSON")
Rel(frontend, caixaController, "Controla caixa", "REST/JSON")

' Relações controllers -> services
Rel(produtoController, produtoService, "Usa")
Rel(vendaController, vendaService, "Usa")
Rel(compraController, compraService, "Usa")
Rel(comandaController, comandaService, "Usa")
Rel(clienteController, clienteService, "Usa")
Rel(caixaController, caixaService, "Usa")

' Relações services -> repositories
Rel(produtoService, produtoRepo, "Usa")
Rel(produtoService, categoriaRepo, "Usa")
Rel(vendaService, vendaRepo, "Usa")
Rel(vendaService, movimentacaoRepo, "Usa")
Rel(vendaService, caixaRepo, "Usa")
Rel(vendaService, clienteRepo, "Usa")
Rel(compraService, compraRepo, "Usa")
Rel(compraService, movimentacaoRepo, "Usa")
Rel(comandaService, comandaRepo, "Usa")
Rel(comandaService, vendaRepo, "Usa")
Rel(comandaService, clienteRepo, "Usa")
Rel(clienteService, clienteRepo, "Usa")
Rel(clienteService, vendaRepo, "Usa")
Rel(caixaService, caixaRepo, "Usa")
Rel(movimentacaoService, movimentacaoRepo, "Usa")

' Relações repositories -> database
Rel(produtoRepo, database, "Lê/Escreve", "JDBC")
Rel(vendaRepo, database, "Lê/Escreve", "JDBC")
Rel(compraRepo, database, "Lê/Escreve", "JDBC")
Rel(comandaRepo, database, "Lê/Escreve", "JDBC")
Rel(clienteRepo, database, "Lê/Escreve", "JDBC")
Rel(caixaRepo, database, "Lê/Escreve", "JDBC")
Rel(movimentacaoRepo, database, "Lê/Escreve", "JDBC")
Rel(categoriaRepo, database, "Lê/Escreve", "JDBC")

' Relações externas
Rel(backend, heroku, "Hospedado em", "Git Push")
Rel(frontend, uploadcare, "Upload de imagens", "HTTPS/API")
Rel(database, heroku, "Hospedado em", "Heroku Postgres")

@enduml
